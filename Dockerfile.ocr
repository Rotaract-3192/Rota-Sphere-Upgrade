FROM python:3.11-slim

WORKDIR /app

# Install system libraries needed by OpenCV / EasyOCR
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .

# Install PyTorch CPU + torchvision + FastAPI + EasyOCR
RUN pip install --no-cache-dir torch torchvision --index-url https://download.pytorch.org/whl/cpu \
    && pip install --no-cache-dir -r requirements.txt

COPY execution ./execution

# Pre-download and bake CRAFT + ResNet model weights into Docker image so cold start is 0s
RUN python -c "import easyocr; easyocr.Reader(['en'], gpu=False)"

EXPOSE 5055

HEALTHCHECK --interval=10s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://127.0.0.1:5055/health || exit 1

CMD ["python", "-m", "execution.ocr_service"]
